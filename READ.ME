git clone https://github.com/yourusername/stock-market-ml
cd stock-market-ml
python -m venv .venv
source .venv/bin/activate   # Windows: .venv\Scripts\activate

# 2. Install
pip install -r requirements.txt

# 3. Run pipeline (Step by Step)
