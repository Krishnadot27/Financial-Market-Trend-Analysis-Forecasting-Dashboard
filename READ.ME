python scripts/run_feature_engineering.py  # Build 125 features
python scripts/run_model_training.py       # Train + compare models
python scripts/run_backtesting.py          # Backtest with NSE costs

# 4. Launch dashboard
streamlit run app/streamlit_app.py
```

